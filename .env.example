# Required: URL or file path to your OpenAPI spec (YAML or JSON)
OPENAPI_SPEC_URL=https://api.example.com/openapi.yaml

# Optional: Override the API base URL (defaults to servers[0].url from the spec)
# API_BASE_URL=https://api.example.com

# Optional: Override the MCP server name (defaults to info.title from the spec)
# MCP_SERVER_NAME=My API

# Optional: Prefix prepended to every tool name, for namespacing (e.g. acme_)
# MCP_TOOL_PREFIX=acme_

# Optional: Local dev server port (default: 3000)
# PORT=3000

# Optional: Comma-separated tags to expose; prefix with - to exclude instead
# MCP_TAGS=Orders,Customers,-Admin

# Optional: Register only read-only operations (GET, or x-mcp-readonly: true)
# MCP_READ_ONLY=1

# Optional: Truncate responses past this many chars (default 40000, 0 = off)
# MCP_MAX_RESPONSE_CHARS=40000
